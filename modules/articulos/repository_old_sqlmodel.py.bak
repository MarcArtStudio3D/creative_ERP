    # ==================== Code Generation ====================

    def check_code_exists(
        self,
        codigo: str = None,
        codigo_barras: str = None,
        codigo_fabricante: str = None,
        exclude_id: int = None,
    ) -> Optional[dict]:
        """
        Comprobar si ya existe un artículo con los códigos indicados.
        Devuelve el artículo existente si se encuentra.
        """
        session = self._session()
        try:
            # Prefer using select over the Articulo model
            # Construir condiciones dinámicamente con SQLModel
            from sqlalchemy import or_

            conditions = []
            if codigo:
                conditions.append(Articulo.codigo == codigo)
            if codigo_barras:
                conditions.append(Articulo.codigo_barras == codigo_barras)
            if codigo_fabricante:
                conditions.append(Articulo.codigo_fabricante == codigo_fabricante)

            if not conditions:
                return None

            stmt = select(Articulo).where(or_(*conditions))
            if exclude_id:
                stmt = stmt.where(Articulo.id != exclude_id)

            res = session.exec(stmt.limit(1))
            art = res.first()
            return art.model_dump() if art else None
        finally:
            if not self._external_session:
                session.close()

    def get_next_code(self, prefix: str, code_length: int) -> str:
        """
        Generar el siguiente código secuencial con el prefijo dado.

        Args:
            prefix: Prefijo del código (p.ej. código de sección+familia+subfamilia)
            code_length: Longitud total del código
        """
        session = self._session()
        try:
            # Usar select sobre Articulo.codigo
            stmt = select(Articulo.codigo).where(Articulo.codigo.like(f"{prefix}%")).order_by(Articulo.codigo.desc()).limit(10)
            res = session.exec(stmt)
            codes = [r[0] for r in res.all()]

            # Calculate next number
            max_num = 0
            for code in codes:
                if code and len(code) >= len(prefix):
                    num_part = code[len(prefix) :]
                    if num_part.isdigit():
                        max_num = max(max_num, int(num_part))

            # Format next code
            next_num = max_num + 1
            num_length = code_length - len(prefix)
            return f"{prefix}{next_num:0{num_length}d}"
        finally:
            if not self._external_session:
                session.close()

    # ==================== Tarifas ====================

    def get_default_tarifa(self) -> int:
        """
        Obtener el ID de tarifa predeterminada desde la configuración.
        Devuelve 1 si no está configurado.
        """
        session = self._session()
        try:
            # Legacy fallback: older schema stored default tarifa in configuracion table
            try:
                result = session.execute(
                    text("SELECT id_tarifa_predeterminada FROM configuracion LIMIT 1")
                )
                row = result.fetchone()
                return int(row[0]) if row and row[0] else 1
            except Exception:
                # The repository may be used in contexts without configuracion table
                return 1

        finally:
            if not self._external_session:
                session.close()

    def create_tarifas_for_article(self, articulo_id: int) -> bool:
        """Crear entradas de tarifas para un nuevo artículo basadas en codigotarifa"""
        session = self._session()
        try:
            # Get all tarifa codes
            result = session.execute(
                text(
                    "SELECT id, id_pais, id_monedas, margen, margen_min FROM codigotarifa"
                )
            )

            for row in result.fetchall():
                session.execute(
                    text(
                        """
                        INSERT INTO tarifas (id_articulo, id_pais, id_monedas, margen, margen_minimo, id_codigo_tarifa)
                        VALUES (:id_articulo, :id_pais, :id_monedas, :margen, :margen_min, :id_codigo)
                    """
                    ),
                    {
                        "id_articulo": articulo_id,
                        "id_pais": row[1],
                        "id_monedas": row[2],
                        "margen": row[3],
                        "margen_min": row[4],
                        "id_codigo": row[0],
                    },
                )

            session.commit()
            return True
        except Exception as e:
            session.rollback()
            raise e
        finally:
            if not self._external_session:
                session.close()

    def insert_oferta(self, articulo_id: int, tarifa_id: int, payload: dict) -> Optional[dict]:
        """
        Insertar una nueva fila en `articulos_ofertas` para el artículo+tarifa.
        Devuelve un diccionario con los campos insertados, incluyendo 'id'.
        """
        session = self._session()
        try:
            sql = text(
                """
                INSERT INTO articulos_ofertas (id_articulo, id_tarifa, descripcion, fecha_inicio, fecha_fin, activa, unidades, regalo, oferta_precio_final, precio_final, dto_local, dto_web, oferta32, oferta_dto, oferta_web)
                VALUES (:id_articulo, :id_tarifa, :descripcion, :fecha_inicio, :fecha_fin, :activa, :unidades, :regalo, :oferta_precio_final, :precio_final, :dto_local, :dto_web, :oferta32, :oferta_dto, :oferta_web)
            """
            )
            params = {
                "id_articulo": articulo_id,
                "id_tarifa": tarifa_id,
                "descripcion": payload.get("descripcion"),
                "fecha_inicio": payload.get("fecha_inicio"),
                "fecha_fin": payload.get("fecha_fin"),
                "activa": bool(payload.get("activa")) if payload.get("activa") is not None else False,
                "unidades": payload.get("unidades") if payload.get("unidades") is not None else 0.0,
                "regalo": payload.get("regalo") if payload.get("regalo") is not None else 0.0,
                "oferta_precio_final": bool(payload.get("oferta_precio_final")) if payload.get("oferta_precio_final") is not None else False,
                "precio_final": payload.get("precio_final") if payload.get("precio_final") is not None else 0.0,
                "dto_local": payload.get("dto_local") if payload.get("dto_local") is not None else 0.0,
                "dto_web": payload.get("dto_web") if payload.get("dto_web") is not None else 0.0,
                "oferta32": bool(payload.get("oferta32")) if payload.get("oferta32") is not None else False,
                "oferta_dto": bool(payload.get("oferta_dto")) if payload.get("oferta_dto") is not None else False,
                "oferta_web": bool(payload.get("oferta_web")) if payload.get("oferta_web") is not None else False,
            }
            result = session.execute(sql, params)
            if not self._external_session:
                session.commit()
            inserted_id = cast(Any, result).lastrowid
            row = {**params, "id": inserted_id}
            return row
        except Exception:
            if not self._external_session:
                session.rollback()
            raise
        finally:
            if not self._external_session:
                session.close()

    def get_oferta_for_article(self, articulo_id: int, tarifa_id: int = None) -> Optional[dict]:
        """Obtener la oferta más reciente para un artículo (y tarifa opcional)."""
        session = self._session()
        try:
            sql = "SELECT id, id_articulo, id_tarifa, descripcion, fecha_inicio, fecha_fin, activa, unidades, regalo, oferta_precio_final as precio_final, dto_local, dto_web, oferta32, oferta_dto, oferta_web FROM articulos_ofertas WHERE id_articulo = :id"
            params = {"id": articulo_id}
            if tarifa_id:
                sql += " AND id_tarifa = :tarifa"
                params["tarifa"] = tarifa_id
            sql += " ORDER BY id DESC LIMIT 1"
            result = session.execute(text(sql), params)
            row = result.fetchone()
            return dict(row._mapping) if row else None
        finally:
            if not self._external_session:
                session.close()

    def get_oferta_by_id(self, oferta_id: int) -> Optional[dict]:
        session = self._session()
        try:
            result = session.execute(
                text(
                    "SELECT id, id_articulo, id_tarifa, descripcion, fecha_inicio, fecha_fin, activa, unidades, regalo, oferta_precio_final as precio_final, dto_local, dto_web, oferta32, oferta_dto, oferta_web FROM articulos_ofertas WHERE id = :id"
                ),
                {"id": oferta_id},
            )
            row = result.fetchone()
            return dict(row._mapping) if row else None
        finally:
            if not self._external_session:
                session.close()

    def upsert_oferta(self, articulo_id: int, tarifa_id: int, payload: dict) -> bool:
        """Actualizar si existe oferta para articulo+tarifa; si no, insertar.
        Devuelve True si operación OK.
        """
        session = self._session()
        try:
            existing = None
            try:
                sql = "SELECT id FROM articulos_ofertas WHERE id_articulo = :id AND id_tarifa = :tarifa ORDER BY id DESC LIMIT 1"
                res = session.execute(text(sql), {"id": articulo_id, "tarifa": tarifa_id})
                row = res.fetchone()
                existing = row[0] if row else None
            except Exception:
                existing = None

            if existing:
                # build update statements from payload
                set_clauses = []
                params = {"id": existing}
                for k, v in payload.items():
                    # keep column same as key (precio_final, oferta_precio_final, etc.)
                    set_clauses.append(f"{k} = :{k}")
                    params[k] = v
                if not set_clauses:
                    return True
                sql = f"UPDATE articulos_ofertas SET {', '.join(set_clauses)} WHERE id = :id"
                session.execute(text(sql), params)
            else:
                # insert
                _ = self.insert_oferta(articulo_id, tarifa_id, payload)
            if not self._external_session:
                session.commit()
            return True
        except Exception:
            if not self._external_session:
                session.rollback()
            raise
        finally:
            if not self._external_session:
                session.close()

    def delete_oferta_by_id(self, oferta_id: int) -> bool:
        session = self._session()
        try:
            session.execute(text("DELETE FROM articulos_ofertas WHERE id = :id"), {"id": oferta_id})
            if not self._external_session:
                session.commit()
            return True
        except Exception:
            if not self._external_session:
                session.rollback()
            raise
        finally:
            if not self._external_session:
                session.close()

    def delete_oferta(self, articulo_id: int, tarifa_id: int) -> bool:
        session = self._session()
        try:
            session.execute(
                text("DELETE FROM articulos_ofertas WHERE id_articulo = :id AND id_tarifa = :tarifa"),
                {"id": articulo_id, "tarifa": tarifa_id},
            )
            if not self._external_session:
                session.commit()
            return True
        except Exception:
            if not self._external_session:
                session.rollback()
            raise
        finally:
            if not self._external_session:
                session.close()
